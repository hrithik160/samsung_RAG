# Copy this file to .env, then enter your Gemini API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_ITEMS_PER_MINUTE=60
GEMINI_EMBEDDING_BATCH_SIZE=8
GEMINI_GENERATION_REQUESTS_PER_MINUTE=10
RAG_BACKEND=gemini
RAG_CORPUS_DIR=documents
RAG_EVENTS_PATH=component5/out/demo_events.jsonl
RAG_INDEX_DIR=component3/index_store
