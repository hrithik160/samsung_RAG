{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/samsung-rag/telemetry-v1.schema.json",
  "title": "Streaming RAG turn event",
  "type": "object",
  "required": ["schema_version", "run_id", "timestamp_unix", "session_id", "turn_id", "decision", "reason_codes", "retrieval_trigger", "sub_queries", "citations", "uncertainty", "processing_ms", "model", "input_tokens_estimate", "output_tokens_estimate", "inference_cost_usd"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "timestamp_unix": {"type": "number"},
    "session_id": {"type": "string", "minLength": 1},
    "turn_id": {"type": "string", "minLength": 1},
    "transcript_length_chars": {"type": "integer", "minimum": 0},
    "decision": {"enum": ["WAIT", "RETRIEVE", "NO_RETRIEVAL"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "retrieval_trigger": {"type": "string"},
    "sub_queries": {"type": "array", "items": {"type": "string"}},
    "citations": {"type": "array", "items": {"type": "object", "required": ["doc_id", "section", "chunk_id"], "properties": {"doc_id": {"type": "string"}, "section": {"type": "string"}, "chunk_id": {"type": "string"}}}},
    "answer_version": {"type": ["integer", "null"], "minimum": 0},
    "uncertainty": {"type": "boolean"},
    "processing_ms": {"type": "number", "minimum": 0},
    "model": {"type": "string"},
    "input_tokens_estimate": {"type": "integer", "minimum": 0},
    "output_tokens_estimate": {"type": "integer", "minimum": 0},
    "inference_cost_usd": {"type": ["number", "null"], "minimum": 0}
  },
  "additionalProperties": false
}
